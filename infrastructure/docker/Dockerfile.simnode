# Simulated infrastructure node. Non-root, no capabilities.
FROM python:3.12-slim

# iproute2 provides tc/netem for latency & packet-loss injection on chaos nodes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin sim
WORKDIR /app
COPY sim_node.py .
USER sim
ENV TARGET_ROLE=http TARGET_PORT=8080
CMD ["python", "sim_node.py"]
